# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# Used by docker-compose to create the database container's superuser password.
POSTGRES_PASSWORD=change-me

# Every script, the dashboard and the API read this.
DATABASE_URL=postgresql://postgres:change-me@localhost:5434/postgres

# Signing key for JWT access tokens: 32+ random characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_TTL_MINUTES=60

# Scale knobs for seed.py.
DAYS=30
BENCH_VECTORS=20000

# Proof-of-work difficulty, in leading hex zeros. 3 is instant; 5 takes minutes.
LEDGER_DIFFICULTY=3

# Benchmark repetitions.
RUNS=7
WARMUP=2
