# Copy to .env and adjust if needed. Every script reads DATABASE_URL.
DATABASE_URL=postgresql://postgres:infra@localhost:5434/postgres

# Scale knobs for seed.py.
DAYS=30
BENCH_VECTORS=20000

# Proof-of-work difficulty, in leading hex zeros. 3 is instant; 5 takes minutes.
LEDGER_DIFFICULTY=3

# Benchmark repetitions.
RUNS=7
WARMUP=2
